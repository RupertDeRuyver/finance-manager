// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Transaction {
  id              Int      @id @default(autoincrement())
  name            String
  amount          Decimal
  category        Category
  date            DateTime
  description     String?
}

model GocardlessTransaction {
  transaction     Transaction
  transactionId   Int
  deleted         Boolean       @default(false)
  bookingDate     DateTime
  valueDate       DateTime
  location        Location?
  creditor        Account?
  debtor          Account?
  comment         String?
  paymentMethod   String?
  bic             String?
  remittanceInformationUnstructured String?
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String
  parent  Category?
}

model Location {
  id          Int      @id @default(autoincrement())
  place       String
  postalCode  String?
  countryCode String?
}

model Account {
  id        Int      @id @default(autoincrement())
  name      String
  account   String?
}